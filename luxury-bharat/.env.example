# ---- Core ----
NODE_ENV=development            # set to "production" on the live server
PORT=3000
APP_URL=http://localhost:3000   # public URL; used in email links and cookie Secure logic
DATA_DIR=./data                 # SQLite DB + uploaded images live here (mount a persistent volume in production)
TRUST_PROXY=0                   # set 1 only when behind a reverse proxy you control (Nginx, Railway, Render...)

# ---- Owner / admin provisioning ----
OWNER_EMAIL=luxurybhaarat@gmail.com
ADMIN_EMAILS=sinhayash3107@gmail.com,20dhruv08@gmail.com
# One-time owner setup token. If empty, a random token is printed to the server console on first boot.
OWNER_SETUP_TOKEN=

# ---- Email (Resend). Without a key, emails are written to the dev outbox + console ----
RESEND_API_KEY=
MAIL_FROM="Luxury Bharat <orders@yourdomain.com>"

# ---- Payments ----
# "test" = clearly labelled fake payment flow (never use in production). "live" = Razorpay.
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
